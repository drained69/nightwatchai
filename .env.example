# NIGHTWATCH AI · environment configuration.
# Copy this file to `.env` and fill in values.
# NEVER put any secret in a VITE_* variable — those are baked into the browser bundle.

# =============================================================================
# CLIENT (browser)  — VITE_* only. These end up in the compiled SPA.
# =============================================================================

# Point the SPA at the API adapter. In dev you can omit this — the vite dev
# server proxies all API paths to http://127.0.0.1:8787 automatically.
# Set it only when the built SPA is hosted on a different origin than the API.
# Omit everywhere to run in the fully-local seeded demo mode.
VITE_AGENT_API_URL=

# =============================================================================
# SERVER (server/adapter.mjs) — never exposed to the browser.
# =============================================================================

# ---- required in production ----
JWT_SECRET=                                  # openssl rand -base64 48

# ---- LLM narration + news classifier (first key present wins: Qwen → xAI → Anthropic → OpenAI) ----
# Qwen uses any OpenAI-compatible endpoint (DashScope, OpenRouter, Together, local vLLM/Ollama).
QWEN_API_KEY=
QWEN_MODEL=qwen3-8b
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
XAI_API_KEY=
XAI_MODEL=grok-4-fast
XAI_BASE_URL=https://api.x.ai/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Bitget MCP sidecar for live bitget-signal skills ----
# Run:  npm i -g @bitget/agent-hub-cli && bgc mcp serve --port 9091
BITGET_MCP_URL=

# ---- Bitget Agent Account OAuth (for live paper routing — see DEPLOYMENT.md §5) ----
BITGET_OAUTH_CLIENT_ID=
BITGET_OAUTH_CLIENT_SECRET=
BITGET_OAUTH_REDIRECT_URI=

# ---- Web Push (see DEPLOYMENT.md §6) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- adapter tuning ----
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
LOG_PRETTY=0
CORS_ORIGIN=*
NIGHTWATCH_DATA_DIR=./data
NEWS_ENABLED=1
NEWS_POLL_MS=60000
NEWS_TIMEOUT_MS=6000
NEWS_KEEP_MAX=120
PRICES_TICK_MS=10000

# ---- live data providers (all keyless public endpoints) ----
BITGET_BASE_URL=https://api.bitget.com
# When Bitget's Cloudflare WAF blocks your host's egress IP (common on Railway
# and other clouds), route through the relay worker — see relay/README.md:
#   BITGET_BASE_URL=https://bitget-relay.<your-subdomain>.workers.dev
#   BITGET_RELAY_KEY=<same secret you set as RELAY_KEY on the Worker>
BITGET_RELAY_KEY=
BITGET_CACHE_MS=5000
BITGET_TIMEOUT_MS=5000
BITGET_STALE_MS=600000
LIVE_UNIVERSE_CACHE_MS=30000
MACRO_CACHE_MS=300000
MACRO_TIMEOUT_MS=6000
# sec.gov requires a declared UA with contact info (their fair-access policy):
SEC_USER_AGENT=NightwatchAI Research admin@yourdomain.com
# Farside ETF-flow CSVs move without notice; override here when they do:
FARSIDE_BTC_CSV=
FARSIDE_ETH_CSV=

# ---- history cache (real candles for backtests/leaderboard/correlations) ----
HISTORY_WARM_CANDLES=2000
HISTORY_MAX_CANDLES=8000

RATE_RESEARCH=60
LLM_TIMEOUT_MS=9000

# ---- transactional email (sign-in codes + Alpha of the Day daily brief) ----
# Without RESEND_API_KEY the mailer runs in log-only mode: /health reports
# mailer.canDeliver=false, sign-in codes drop into the server log, and the
# 02:00 brief still generates but no email is sent. Set both for production.
RESEND_API_KEY=
EMAIL_FROM=NIGHTWATCH AI <onboarding@resend.dev>
EMAIL_TIMEOUT_MS=10000
# Absolute URL used in outbound email links (open-in-app, unsubscribe).
APP_URL=http://localhost:8787

# ---- Alpha of the Day scheduler ----
# When the daily market intelligence brief fires (UTC). Default: 02:00.
NIGHTWATCH_02_HOUR=2
NIGHTWATCH_02_MINUTE=0
# Set to 0 to disable the in-process scheduler entirely (POST /nightwatch/run
# still works for manual runs).
NIGHTWATCH_02_ENABLED=1
# In production, required in the X-Admin-Token header for POST /nightwatch/run.
# In development, any authenticated user can trigger a manual run without it.
ADMIN_TOKEN=
