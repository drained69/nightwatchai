# NIGHTWATCH AI · environment configuration.
# Copy this file to `.env` and fill in values.
# NEVER put any secret in a VITE_* variable — those are baked into the browser bundle.

# =============================================================================
# CLIENT (browser)  — VITE_* only. These end up in the compiled SPA.
# =============================================================================

# Point the SPA at the API adapter. In dev you can omit this — the vite dev
# server proxies all API paths to http://127.0.0.1:8787 automatically.
# Set it only when the built SPA is hosted on a different origin than the API.
# Omit everywhere to run in the fully-local seeded demo mode.
VITE_AGENT_API_URL=

# =============================================================================
# SERVER (server/adapter.mjs) — never exposed to the browser.
# =============================================================================

# ---- required in production ----
JWT_SECRET=                                  # openssl rand -base64 48

# ---- LLM narration + news classifier (first key present wins) ----
XAI_API_KEY=
XAI_MODEL=grok-4-fast
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# ---- Bitget MCP sidecar for live bitget-signal skills ----
# Run:  npm i -g @bitget/agent-hub-cli && bgc mcp serve --port 9091
BITGET_MCP_URL=

# ---- Bitget Agent Account OAuth (for live paper routing — see DEPLOYMENT.md §5) ----
BITGET_OAUTH_CLIENT_ID=
BITGET_OAUTH_CLIENT_SECRET=
BITGET_OAUTH_REDIRECT_URI=

# ---- Web Push (see DEPLOYMENT.md §6) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- adapter tuning ----
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
LOG_PRETTY=0
CORS_ORIGIN=*
NIGHTWATCH_DATA_DIR=./data
NEWS_ENABLED=1
NEWS_POLL_MS=60000
NEWS_TIMEOUT_MS=6000
NEWS_KEEP_MAX=120
PRICES_TICK_MS=10000

# ---- live data providers (all keyless public endpoints) ----
BITGET_BASE_URL=https://api.bitget.com
BITGET_CACHE_MS=5000
BITGET_TIMEOUT_MS=5000
BITGET_STALE_MS=600000
LIVE_UNIVERSE_CACHE_MS=30000
MACRO_CACHE_MS=300000
MACRO_TIMEOUT_MS=6000
# sec.gov requires a declared UA with contact info (their fair-access policy):
SEC_USER_AGENT=NightwatchAI Research admin@yourdomain.com
# Farside ETF-flow CSVs move without notice; override here when they do:
FARSIDE_BTC_CSV=
FARSIDE_ETH_CSV=

# ---- history cache (real candles for backtests/leaderboard/correlations) ----
HISTORY_WARM_CANDLES=2000
HISTORY_MAX_CANDLES=8000

RATE_RESEARCH=60
LLM_TIMEOUT_MS=9000
